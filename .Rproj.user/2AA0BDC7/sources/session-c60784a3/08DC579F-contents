library(tidyverse)
library(readxl)
library(taxize)

load("data/dispeRsal.rda")
# load("data/debTaxonomy_040924.Rdata")

dispersal_db <- read_xlsx("data/weed dispersal data 2024-04-24.xlsx")

#######
# Sort the taxonomy
# First get standardised taxa lists via <<taxize>>

cl_gbif <- classification(dispersal_db$species, db = "gbif", rows = 1) # rows here to stop ia sel
cl_gbif_rb <- rbind(cl_gbif)

marram <- classification("Ammophila arenaria", db = 'gbif', rows = 2)

cl_gbif_rb <- cl_gbif_rb %>%
  filter(!query == "Ammophila arenaria") %>%
  rbind(rbind(marram))

cl_all <- cl_gbif_rb %>% 
  filter(rank %in% c("family", "order"))

cl_all_pw <- cl_all %>%
  pivot_wider(id_cols = c(query), names_from = rank, values_from = name)

dispersal_db_tax <- dispersal_db %>%
  left_join(cl_all_pw, by = join_by(species == query))

save.image("data/debTaxonomy_240424.RData")


###########
# Get data into format for dispeRsal
# need DS (dispersal syndrome), growth-form (GF), release height (RH, log10), seed mass (SM), terminal vel (TV)
# Seed.mass = SM, DS = mechanism1, height = RH, TV = NA


# For the dispersal mechanisms, I think we should assign scatter-hoarding to animal. The wind category is what I used for wind.special. We won’t be able to model dispersal distances for the water mechanism unfortunately, so that will just need to be removed from the data set for the modelling aspect. Yes, definitely run the model for each mechanism for each species. 
load("data/debTaxonomy_240324.RData")

source("src/tidyMechanisms.r")
source("src/dispersal_gp.r")

save.image("data/debTaxonomy_240424.RData")

######
#  Now the models themselves
model2_pred <- dispeRsal_gp(dispersal_db_tax_allMech %>% filter(model == 2), model = 2, 
      CI = TRUE, random = TRUE, tax = "family", write.result = FALSE) # , write.file = "predictedDD_model2_mech1.txt")

model3_pred <- dispeRsal_gp(dispersal_db_tax_allMech %>% filter(model == 3), model = 3, 
      CI = FALSE, random = TRUE, tax = "family", write.result = FALSE) #, write.file = "predictedDD_model2_mech2.txt")

model4_pred <- dispeRsal_gp(dispersal_db_tax_allMech %>% filter(model == 4), model = 4,
      CI = TRUE, random = TRUE, tax = "family", write.result = FALSE) #, write.file = "predictedDD_model2_mech3.txt")

model5_pred <- dispeRsal_gp(dispersal_db_tax_allMech %>% filter(model == 5), model = 5, 
      CI = TRUE, random = FALSE, tax = "family", write.result = FALSE) #, write.file = "predictedDD_model2_mech4.txt")



all_predictions <- bind_rows(model2_pred$predictions,
                model3_pred$predictions,
                model4_pred$predictions,
                model5_pred$predictions,
                .id = "model_number") %>%
    mutate(model_number = model_number + 1)


# tidy up and identify the best p[rediction for each on nested random family model
all_predictions <- all_predictions %>%
  mutate(Species = str_replace(Species, "_mech.", "")) %>%
  distinct() %>%
  as_tibble()  %>%
  mutate(log10MDD_best = 
    case_when(
      !is.na(log10MDD_Family) ~ log10MDD_Family,
      !is.na(log10MDD_Order) & is.na(log10MDD_Family) ~ log10MDD_Order,
      is.na(log10MDD_Order)  & is.na(log10MDD_Family) ~ log10MDD,
      .default = NA),
    log10MDD_best_lwrCL = 
    case_when(
      !is.na(log10MDD_Family_lwrCL) ~ log10MDD_Family_lwrCL,
      !is.na(log10MDD_Order_lwrCL) & is.na(log10MDD_Family_lwrCL) ~ log10MDD_Order_lwrCL,
      is.na(log10MDD_Order_lwrCL)  & is.na(log10MDD_Family_lwrCL) ~ log10MDD_lwrCL,
      .default = NA),
      log10MDD_best_uppCL = 
    case_when(
      !is.na(log10MDD_Family_uppCL) ~ log10MDD_Family_uppCL,
      !is.na(log10MDD_Order_uppCL) & is.na(log10MDD_Family_uppCL) ~ log10MDD_Order_uppCL,
      is.na(log10MDD_Order_uppCL)  & is.na(log10MDD_Family_uppCL) ~ log10MDD_uppCL,
      .default = NA),
    )


write_csv(all_predictions, "dispersalDistance.csv")
